# --- Notion ------------------------------------------------------------------
# Internal integration token: https://www.notion.so/profile/integrations
# The pull only sees pages the integration has been given access to.
NOTION_API_KEY=

# --- Qdrant ------------------------------------------------------------------
# Cluster URL and key from the cluster's API keys page.
# The collection is created on first run and must be this repo's own -- one built
# by company-brain is refused at startup, since it names its vector after the
# embedding model and holds a different kind of record.
QDRANT_CLUSTER_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=

# --- Tenant ------------------------------------------------------------------
# The company these records belong to, and the isolation boundary: nothing written
# under one tenant is readable under another.
COMPANY_TENANT_ID=
